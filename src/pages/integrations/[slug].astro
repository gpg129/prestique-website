---
import { canonicalFor } from '../../lib/canonical'
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import VerticalHero from '../../components/VerticalHero.astro'
import VerticalFAQ from '../../components/VerticalFAQ.astro'
import LeadForm from '../../components/LeadForm.astro'
import BookCallCTA from '../../components/BookCallCTA.astro'
import Footer from '../../components/Footer.astro'
import { formatDate, liveIntegrations, verticalFor } from '../../lib/integrations'
import '../../styles/global.css'

export async function getStaticPaths() {
  return (await liveIntegrations()).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }))
}

const { entry } = Astro.props
const d = entry.data
const vertical = verticalFor(d.vertical)
const industry = vertical?.industry ?? 'Small Business'
const audience = vertical?.label ?? 'Small Businesses'
const sourceIndex = new Map(d.sources.map((s, i) => [s.id, i + 1]))
const canonical = canonicalFor(`/integrations/${d.slug}`)
---
<Layout title={d.title} description={d.metaDescription} canonicalURL={canonical}>
  <Nav />
  <main>
    <VerticalHero industry={`${d.platform} + AI`} headline={d.headline} subhead={d.subhead}
                  statBadge={`Last verified ${formatDate(d.lastVerified)}`} />

    <section class="py-20 px-6">
      <div class="max-w-4xl mx-auto">
        <p class="section-label mb-2">What {d.platform}'s API makes possible</p>
        <p class="text-p-muted text-sm mb-4">From {d.platform}'s own published documentation. Prestique connects the agent to these.</p>
        <ul class="space-y-3 mb-12">
          {d.capabilities.map((c) => (
            <li class="glass-card p-5 text-white flex gap-3 items-start">
              <span class="text-p-blue">✓</span>
              <span>{c.text}{c.factIds.map((id) => sourceIndex.get(id)).filter(Boolean).map((n) => (
                <sup class="text-p-muted ml-0.5"><a href={`#source-${n}`}>[{n}]</a></sup>
              ))}</span>
            </li>
          ))}
        </ul>
        {d.intro.map((p) => <p class="text-p-muted text-lg leading-relaxed mb-5">{p}</p>)}
      </div>
    </section>

    <section class="py-16 px-6">
      <div class="glow-divider mb-16"></div>
      <div class="max-w-5xl mx-auto">
        <p class="section-label mb-4 text-center">How it works</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {d.howItWorks.map((s, i) => (
            <div class="glass-card p-6">
              <p class="text-p-blue text-sm mb-2">Step {i + 1}</p>
              <h3 class="text-white font-semibold text-lg mb-2">{s.title}</h3>
              <p class="text-p-muted text-sm leading-relaxed">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="audit-form" class="py-24 px-6">
      <div class="glow-divider mb-24"></div>
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <p class="section-label mb-4">Free Audit</p>
          <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight mb-6">See what we'd build around {d.platform}.</h2>
        </div>
        <div class="glass-card p-8 md:p-10">
          <LeadForm industry={industry} audience={audience} />
        </div>
      </div>
    </section>

    <BookCallCTA />

    <VerticalFAQ faqs={d.faqs} industry={industry} audience={audience} />

    <section class="py-16 px-6">
      <div class="max-w-4xl mx-auto text-sm text-p-muted">
        {vertical && (
          <p class="mb-6">More on what Prestique builds for {audience.toLowerCase()}: <a class="text-p-glow" href={`/${vertical.slug}`}>{vertical.industry}</a> · <a class="text-p-glow" href="/integrations">All integrations</a></p>
        )}
        <p class="text-white font-semibold mb-2">Sources</p>
        <ol class="space-y-1 mb-6 list-decimal pl-5">
          {d.sources.map((s, i) => (
            <li id={`source-${i + 1}`}><a class="hover:text-white break-all" href={s.url} rel="nofollow noopener" target="_blank">{s.label}</a> · checked {formatDate(s.retrieved)}</li>
          ))}
        </ol>
        <p>Prestique is not affiliated with {d.platform}. {d.platform} is a trademark of its owner. Details are taken from {d.platform}'s own published pages and re-checked regularly.</p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
