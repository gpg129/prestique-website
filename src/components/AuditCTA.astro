---
const AUDIT_URL = 'https://audit.prestique.ai';
---
<section class="pb-24 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="glass-card px-7 py-7 md:px-10 md:py-8 flex flex-col md:flex-row md:items-center justify-between gap-6 fade-up">
      <div>
        <h2 class="text-xl md:text-2xl font-semibold text-white tracking-tight mb-1.5">Not ready to talk yet?</h2>
        <p class="text-p-muted leading-relaxed">
          Take the free 5-minute audit and get a custom report by email: your top opportunities and what we'd build first.
        </p>
      </div>
      <a href={AUDIT_URL} class="btn-secondary whitespace-nowrap flex-shrink-0" target="_blank" rel="noopener">
        Start the free audit →
      </a>
    </div>
  </div>
</section>
