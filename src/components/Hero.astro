---
import HeroCallTabs from './HeroCallTabs.astro'
const AUDIT_URL = 'https://audit.prestique.ai';
---
<section class="relative pt-32 pb-16 md:pt-40 md:pb-20 px-6 overflow-hidden">
  <!-- Soft background glow -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1100px] h-[700px] rounded-full opacity-25"
         style="background: radial-gradient(ellipse, #1a2e4a 0%, transparent 70%);"></div>
  </div>

  <div class="relative max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-14 items-center">
    <div class="text-center lg:text-left">
      <p class="section-label mb-6">AI receptionists &amp; follow-up for service businesses</p>

      <h1 class="text-4xl sm:text-5xl lg:text-[3.25rem] font-semibold text-white leading-[1.08] tracking-tight mb-6">
        Your phones miss calls.
        <span class="block text-p-muted">We build the AI that answers them.</span>
      </h1>

      <p class="text-lg md:text-xl text-p-muted max-w-2xl mx-auto lg:mx-0 mb-10 leading-relaxed">
        Prestique builds custom AI receptionists and follow-up automation for service businesses. Every call answered, every lead followed up, booked into your calendar.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center lg:justify-start items-center">
        <a href="#book-a-call" class="btn-primary text-base px-7 py-3.5">Book a call</a>
        <a href={AUDIT_URL} class="btn-link text-base" target="_blank" rel="noopener">Or get a free 5-minute audit →</a>
      </div>
      <p class="text-p-muted/80 text-sm mt-5">
        30 minutes &nbsp;·&nbsp; No prep needed &nbsp;·&nbsp; No obligation
      </p>
    </div>

    <HeroCallTabs />
  </div>
</section>
