---
// Proof strip under the hero. Every line must stay literally true: no numbers we
// haven't measured, no client names, no certifications we don't hold.
import { liveIntegrations } from '../lib/integrations'
const hasIntegrations = (await liveIntegrations()).length > 0
const items = [
  { title: 'Answers every call', body: 'Day, night and weekends', icon: 'M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z' },
  { title: 'Hands off to your team', body: 'Whenever a caller asks for a person', icon: 'M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z' },
  { title: 'Fits your software', body: 'Built around the systems you already run', icon: 'M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244', href: hasIntegrations ? '/integrations' : undefined },
  { title: 'Prestique LLC', body: 'Written security policy', icon: 'M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z' },
]
---
<section class="px-6" aria-label="Why Prestique">
  <div class="max-w-6xl mx-auto border-y border-white/[0.06] py-7 grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-6">
    {items.map((item) => {
      const Tag = item.href ? 'a' : 'div'
      return (
        <Tag href={item.href} class={`flex items-start gap-3 ${item.href ? 'group' : ''}`}>
          <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-p-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
          </svg>
          <span>
            <span class={`block text-sm font-semibold text-white ${item.href ? 'group-hover:text-p-glow transition-colors' : ''}`}>{item.title}</span>
            <span class="block text-sm text-p-muted leading-snug">{item.body}</span>
          </span>
        </Tag>
      )
    })}
  </div>
</section>
