---
// "More guides" block at the foot of every blog post: same-vertical neighbours + the vertical's
// landing page. See src/lib/relatedPosts.ts for why neighbours rather than newest.
import { getCollection } from 'astro:content'
import { neighbours, VERTICAL_PAGE } from '../lib/relatedPosts'

interface Props { id: string; vertical: string; label: string }
const { id, vertical, label } = Astro.props as Props
const posts = await getCollection('blog', ({ data }) => !data.draft)
const related = neighbours(posts, id, 4)
const hub = VERTICAL_PAGE[vertical]
---
{(related.length > 0 || hub) && (
  <section class="mt-16">
    {related.length > 0 && (
      <>
        <h2 class="text-xl font-bold text-white mb-6">More guides for {label}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {related.map((post) => (
            <a href={`/blog/${post.id}`} class="glass-card p-5 hover:bg-p-navy/40 transition-colors flex flex-col">
              <h3 class="text-white font-semibold leading-snug mb-2">{post.data.title}</h3>
              <p class="text-p-muted text-sm leading-relaxed line-clamp-2">{post.data.description}</p>
            </a>
          ))}
        </div>
      </>
    )}
    {hub && (
      <p class="mt-6 text-sm">
        <a href={hub} class="text-p-glow font-medium hover:underline">See how Prestique works for {label} →</a>
      </p>
    )}
  </section>
)}
