---
const steps = [
  {
    title: 'Book a 30-minute call',
    body: 'We look at how calls and leads reach you today, and where they slip.',
  },
  {
    title: 'Get a written plan',
    body: "What we'd build, how it connects to the systems you already use, the timeline and the cost.",
  },
  {
    title: 'We build it and run it',
    body: 'Call handling goes live in the first week. We tune it with you after launch.',
  },
]
---
<section class="py-24 px-6">
  <div class="glow-divider mb-24"></div>
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-14 fade-up">
      <p class="section-label mb-4">How it works</p>
      <h2 class="text-3xl md:text-4xl font-semibold text-white leading-tight tracking-tight">
        How working with us goes.
      </h2>
    </div>

    <ol class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {steps.map((step, i) => (
        <li class="glass-card p-7 fade-up" style={`transition-delay: ${0.05 * (i + 1)}s;`}>
          <p class="text-p-blue text-sm font-semibold tabular-nums mb-5">0{i + 1}</p>
          <h3 class="text-white font-semibold text-lg mb-2">{step.title}</h3>
          <p class="text-p-muted leading-relaxed">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
